{
  "firestore_structure": {
    "notifications": {
      "<stakeholder_uid>": {
        "metadata": {
          "description": "One document per stakeholder (user or purohit). UID matches their respective collection document ID.",
          "type": "collection"
        },
        "subcollections": {
          "items": {
            "<notification_id>": {
              "metadata": {
                "description": "Individual notification entry for the stakeholder.",
                "type": "collection"
              },
              "fields": {
                "title": "string",
                "body": "string",
                "isRead": "boolean",
                "isActive": "boolean",
                "timestamp": "timestamp",
                "type": "string",
                "deepLinkUrl": "string"
              }
            }
          }
        }
      }
    },
    "purohits": {
      "<purohit_id>": {
        "metadata": {
          "description": "Profiles for service providers (Purohits).",
          "type": "collection"
        },
        "fields": {
          "purohitId": "string",
          "name": "string",
          "phone": "string",
          "email": "string",
          "city": "string",
          "locality": "string",
          "experience": "number",
          "proficiency": ["string"],
          "serviceIds": ["string"],
          "fcmTokens": ["string"],
          "isVerified": "boolean",
          "isAvailable": "boolean",
          "rating": "number",
          "totalBookings": "number",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      }
    },
    "services": {
      "<slug>": {
        "metadata": {
          "description": "Individual service document.",
          "type": "collection"
        },
        "fields": {
          "name": "string",
          "slug": "string",
          "price": "number",
          "displayOrder": "number",
          "isActive": "boolean",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      }
    },
    "users": {
      "<user_id>": {
        "metadata": {
          "description": "Basic profile information for end-users/customers.",
          "type": "collection"
        },
        "fields": {
          "userId": "string",
          "name": "string",
          "phone": "string",
          "email": "string",
          "fcmTokens": ["string"],
          "createdAt": "timestamp"
        }
      }
    },
    "bookings": {
      "<booking_id>": {
        "metadata": {
          "description": "Transaction record.",
          "type": "collection"
        },
        "fields": {
          "bookingId": "string",
          "userId": "string",
          "purohitId": "string",
          "purohitName": "string",
          "userPhone": "string",
          "serviceName": "string",
          "amount": "number",
          "status": "string",
          "razorpayOrderId": "string",
          "razorpayPaymentId": "string",
          "scheduledDate": "timestamp",
          "address": "string",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      }
    }
  }
}