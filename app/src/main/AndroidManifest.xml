<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:allowBackup="true"
        android:name=".bookpurohit.BookPurohitApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PoojaPurohit"
        tools:targetApi="31">

        <activity
            android:name=".splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PoojaPurohit.MySplash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".auth.compose.AuthActivity"
            android:exported="true"
            android:theme="@style/Theme.PoojaPurohit"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <activity
            android:name="com.poojapurohit.dashboard.DashActivity"
            android:exported="true"
            android:theme="@style/Theme.PoojaPurohit">
        </activity>

        <activity
            android:name="com.poojapurohit.dashboard.InfoActivity"
            android:exported="false"
            android:theme="@style/Theme.PoojaPurohit">
        </activity>

        <activity
            android:name=".dashboard.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.PoojaPurohit">
        </activity>

        <activity
            android:name=".notification.compose.NotificationActivity"
            android:exported="false"
            android:theme="@style/Theme.PoojaPurohit">
        </activity>

        <activity
            android:name=".bookpurohit.BookPurohitActivity"
            android:exported="false"
            android:theme="@style/Theme.PoojaPurohit">
        </activity>

        <!-- Added BookingsActivity with deep link intent filter -->
        <activity
            android:name=".booking.BookingsActivity"
            android:launchMode="singleTop"
            android:exported="true"
            android:theme="@style/Theme.PoojaPurohit">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="poojapurohit"
                    android:host="bookings" />
            </intent-filter>
        </activity>

    </application>

</manifest>