<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:id="@+id/cardView"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="#DBA72B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        tools:ignore="TextSizeCheck">

        <!-- Square ImageView on the left -->
        <ImageView
            android:id="@+id/ivCardBackground"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:scaleType="centerCrop"
            tools:ignore="HardcodedText,ImageContrastCheck"
            tools:src="@mipmap/ic_launcher" />

        <!-- Text content on the right -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <!-- Service Name -->
            <TextView
                android:id="@+id/tvServiceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Service" />

            <!-- Service Description -->
            <TextView
                android:id="@+id/tvServiceDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:minLines="1"
                android:lineSpacingMultiplier="1.1"
                android:textColor="#666666"
                android:textSize="13sp"
                tools:ignore="TextContrastCheck"
                tools:text="Traditional puja services for all occasions with detailed rituals and ceremonies" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
