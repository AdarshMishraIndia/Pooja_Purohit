<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFB500"/> <!-- golden when pressed -->
            <corners android:radius="50dp"/> <!-- round button -->
            <padding android:left="20dp"
                android:top="12dp"
                android:right="20dp"
                android:bottom="12dp"/>
            <stroke android:width="2dp" android:color="#811C01"/> <!-- border -->
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#811C01"/> <!-- dark maroon background -->
            <corners android:radius="50dp"/>
            <padding android:left="20dp"
                android:top="12dp"
                android:right="20dp"
                android:bottom="12dp"/>
            <stroke android:width="2dp" android:color="#FFB500"/> <!-- border -->
        </shape>
    </item>

</selector>
